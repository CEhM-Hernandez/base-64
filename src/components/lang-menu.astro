---
import { Globe, ChevronDown } from '@lucide/astro'

interface Props {
  currentLang: string
  languages: Record<
    string,
    {
      label: string
      flag: string
    }
  >
  defaultLang: string
}

const { currentLang, languages, defaultLang } = Astro.props
---

<button
  id="lang-toggle"
  type="button"
  class="flex items-center gap-2 rounded-lg border border-border bg-card px-3 py-2 text-sm font-medium transition-colors hover:bg-accent"
  aria-label="Cambiar idioma"
  aria-expanded="false"
  aria-haspopup="true"
>
  <Globe class="size-4" />
  <span>{languages[currentLang].flag}</span>
  <ChevronDown class="size-3 opacity-60" />
</button>

<div
  id="lang-menu"
  class="absolute right-0 top-full mt-2 hidden min-w-35 overflow-hidden rounded-lg border border-border bg-card shadow-lg"
  role="menu"
>
  {
    Object.entries(languages).map(([code, { label, flag }]) => (
      <a
        href={code === defaultLang ? '/' : `/${code}/`}
        class:list={[
          'flex items-center gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-accent',
          { 'bg-accent/50': code === currentLang }
        ]}
        role="menuitem"
      >
        <span class="text-base">{flag}</span>
        <span>{label}</span>
      </a>
    ))
  }
</div>

<script>
  const toggle = document.getElementById('lang-toggle')
  const menu = document.getElementById('lang-menu')

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false
    toggle.setAttribute('aria-expanded', String(isOpen))
  })

  document.addEventListener('click', (e) => {
    if (!toggle?.contains(e.target as Node) && !menu?.contains(e.target as Node)) {
      menu?.classList.add('hidden')
      toggle?.setAttribute('aria-expanded', 'false')
    }
  })
</script>

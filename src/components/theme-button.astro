---
import Switch from '@/components/ui/switch.astro'
import { Moon, Sun } from '@lucide/astro'
---

<div data-theme-switch>
  <Switch variant="primary" aria-label="Toggle theme">
    <span class="relative size-full">
      <Sun
        class="text-primary-foreground absolute inset-0 p-px transition-all duration-300 rotate-0 scale-100 dark:-rotate-90 dark:scale-0"
      />
      <Moon
        class="text-primary absolute inset-0 p-px transition-all duration-300 rotate-90 scale-0 dark:rotate-0 dark:scale-100"
      />
    </span>
  </Switch>
</div>

<script>
  import { $$ } from '@/utils/get-element'

  function initTheme() {
    const themeSwitches = $$('[data-theme-switch] input') as NodeListOf<HTMLInputElement>
    if (!themeSwitches.length) return

    const getTheme = () => {
      const stored = localStorage.getItem('theme')
      if (stored) return stored
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }

    const applyTheme = (theme: string) => {
      document.documentElement.classList.toggle('dark', theme === 'dark')
      localStorage.setItem('theme', theme)
      themeSwitches.forEach((sw) => (sw.checked = theme === 'dark'))
    }

    applyTheme(getTheme())

    themeSwitches.forEach((sw) => {
      sw.addEventListener('change', () => applyTheme(sw.checked ? 'dark' : 'light'))
    })

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem('theme')) {
        applyTheme(e.matches ? 'dark' : 'light')
      }
    })
  }

  initTheme()
  document.addEventListener('astro:after-swap', initTheme)
</script>

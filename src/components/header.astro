---
import { CodeXml } from '@lucide/astro'
import { languages, defaultLang, type Language } from '@/lang'
import { useTranslations } from '@/lang'
import LangMenu from '@/components/lang-menu.astro'
import ThemeButton from '@/components/theme-button.astro'
import GithubRepo from '@/components/github-repo.astro'
import MobileHeader from '@/components/mobile-header.astro'

interface Props {
  currentLang?: Language
}

const { currentLang = defaultLang } = Astro.props

const lang = useTranslations(currentLang)
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-card/50 backdrop-blur-sm">
  <div class="mx-auto flex h-14 sm:h-16 max-w-7xl items-center justify-between px-3 sm:px-4">
    <a
      href={`${currentLang === defaultLang ? '/' : `/${currentLang}`}`}
      class="flex items-center gap-2 sm:gap-3 transition-opacity hover:opacity-80 min-w-0 flex-1"
    >
      <div class="flex p-1.5 sm:p-2 items-center justify-center rounded-md bg-foreground shrink-0">
        <CodeXml class="size-5 sm:size-7 text-background" />
      </div>
      <div class="flex flex-col h-full justify-center min-w-0">
        <h1 class="text-sm sm:text-lg font-semibold tracking-tight truncate">{lang.title}</h1>
        <p class="text-xs sm:text-sm text-muted-foreground truncate">{lang.description}</p>
      </div>
    </a>

    <div class="relative hidden md:flex items-center gap-2 sm:gap-4 shrink-0">
      <GithubRepo />
      <LangMenu currentLang={currentLang} languages={languages} defaultLang={defaultLang} />
      <ThemeButton />
    </div>
    <MobileHeader currentLang={currentLang} />
  </div>
</header>

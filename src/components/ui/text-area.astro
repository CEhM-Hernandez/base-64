---
import type { TextAreaProps } from '@/types/components/text-area'
import { cn } from '@/utils/cn'
import { cva } from 'class-variance-authority'

type Props = TextAreaProps

const { class: className, autoGrow = true, ...rest } = Astro.props

const TextAreaVariants = cva(
  cn(
    'flex w-full min-h-16',
    'text-base md:text-sm',
    'px-4 py-3 rounded-lg',
    'bg-muted border border-input',
    'placeholder:text-muted-foreground',
    'shadow-sm outline-none',
    'transition-all duration-200',
    'hover:border-ring/60 hover:shadow-sm',
    'focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:shadow-md',
    'aria-invalid:border-destructive aria-invalid:ring-destructive/20',
    'disabled:cursor-not-allowed disabled:opacity-50',
    'read-only:bg-secondary/50 read-only:cursor-default',
    'read-only:hover:border-input/60',
    'read-only:focus-visible:ring-0 read-only:focus-visible:border-input',
    'scrollbar-thin scrollbar-track-transparent scrollbar-thumb-border',
    'hover:scrollbar-thumb-ring/60',
    '[&::-webkit-scrollbar]:w-2',
    '[&::-webkit-scrollbar-track]:bg-transparent',
    '[&::-webkit-scrollbar-thumb]:bg-border [&::-webkit-scrollbar-thumb]:rounded-full',
    '[&::-webkit-scrollbar-thumb]:hover:bg-ring/60'
  ),
  {
    variants: {
      autoGrow: {
        true: 'field-sizing-content resize-none overflow-hidden',
        false: 'resize-y'
      }
    },
    defaultVariants: {
      autoGrow: true
    }
  }
)

const classes = cn(TextAreaVariants({ autoGrow }), className)
---

<textarea data-slot="textarea" class={classes} {...rest}></textarea>

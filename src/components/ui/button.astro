---
import type { ButtonProps } from '@/types/components/button'
import { cn } from '@/utils/cn'
import { cva } from 'class-variance-authority'

type Props = ButtonProps

const { variant = 'primary', size = 'md', class: className, ...rest } = Astro.props

const buttonVariants = cva(
  "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg:not([class*='size-'])]:size-4 shrink-0 [&_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive cursor-pointer",
  {
    variants: {
      variant: {
        primary: 'bg-primary text-primary-foreground hover:bg-primary/80',
        secondary: 'bg-secondary text-secondary-foreground hover:bg-secondary/80',
        ghost: 'bg-transparent hover:bg-accent text-foreground',
        link: 'bg-transparent underline-offset-4 hover:underline text-foreground',
        destructive: 'bg-destructive text-destructive-foreground hover:bg-destructive/80'
      },
      size: {
        md: 'h-9 px-4 py-2 has-[>svg]:px-3',
        sm: 'h-8 rounded-md gap-1.5 px-3 has-[>svg]:px-2.5',
        lg: 'h-10 rounded-md px-6 has-[>svg]:px-4',
        icon: 'size-9 aspect-square',
        'icon-sm': 'size-8 aspect-square',
        'icon-lg': 'size-10 aspect-square'
      }
    },
    defaultVariants: {
      variant: 'primary',
      size: 'md'
    }
  }
)

const classes = cn(buttonVariants({ variant, size, class: className }))
---

<button class:list={classes} {...rest}>
  <slot />
</button>

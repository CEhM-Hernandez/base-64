---
import Textarea from '@/components/ui/text-area.astro'
import Card from '@/components/ui/card.astro'
import Button from '@/components/ui/button.astro'
import { ArrowLeftRight, Copy } from '@lucide/astro'
import { useTranslations } from '@/lang'
import type { Language } from '@/lang'

const url = Astro.url
const currentLang =
  url.pathname.split('/')[1] === '' ? ('es' as Language) : (url.pathname.split('/')[1] as Language)
const lang = useTranslations(currentLang)
const t = lang.content
---

<Card class="w-full h-fit gap-2">
  <div class="w-full items-center text-sm font-medium col-span-full flex self-end">
    <label for="from" class="w-full pl-8 font-bold">{t.naturalLanguage}</label>
    <Button
      class="size-8 w-fit self-center"
      size="icon"
      variant="secondary"
      id="swap"
      title={t.swap}
    >
      <ArrowLeftRight />
    </Button>
    <label for="to" class="w-full pl-8 font-bold">{t.base64}</label>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-start auto-rows-auto">
    <section class="min-h-50 w-full h-full rounded-md flex flex-col gap-2 flex-1">
      <Textarea class="min-h-50 h-full" name="decoded" id="from" placeholder={t.inputPlaceholder} />
    </section>
    <section class="min-h-50 w-full h-full rounded-md flex flex-col gap-2 flex-1 relative">
      <Textarea
        class="min-h-50 h-full pr-10"
        name="encoded"
        id="to"
        placeholder={t.outputPlaceholder}
        readonly
      />
      <Button
        class="absolute top-2 right-2 size-8 z-10 pointer-events-auto hidden"
        size="icon"
        variant="secondary"
        title={t.copyToClipboard}
        id="copy-to-clipboard"
      >
        <Copy class="size-5" />
      </Button>
    </section>
  </div>
</Card>

<script
  is:inline
  define:vars={{
    encodeError: t.encodeError,
    decodeError: t.decodeError,
    successCopy: t.successCopy
  }}
>
  window.__i18n = { encodeError, decodeError, successCopy }
</script>

<script>
  import { $ } from '@/utils/get-element'
  import { encodeBase64 } from '@/utils/base64-encode'
  import { decodeBase64 } from '@/utils/base64-decode'
  import { copyToClipboard } from '@/utils/copy-to-clipboard'

  declare global {
    interface Window {
      __i18n: { encodeError: string; decodeError: string; successCopy: string }
    }
  }

  const { encodeError, decodeError, successCopy } = window.__i18n

  const fromTextarea = $('#from') as HTMLTextAreaElement
  const fromLabel = $('label[for="from"]') as HTMLLabelElement
  const toLabel = $('label[for="to"]') as HTMLLabelElement
  const toTextarea = $('#to') as HTMLTextAreaElement
  const swapButton = $('#swap') as HTMLButtonElement
  const copyButton = $('#copy-to-clipboard') as HTMLButtonElement

  const isDecoding = () => fromTextarea.name === 'decoded'

  const debounce = <T extends (...args: unknown[]) => void>(fn: T, delay: number) => {
    let timeoutId: ReturnType<typeof setTimeout>
    return (...args: Parameters<T>) => {
      clearTimeout(timeoutId)
      timeoutId = setTimeout(() => fn(...args), delay)
    }
  }

  const transform = () => {
    toTextarea.value = isDecoding()
      ? encodeBase64(fromTextarea.value, encodeError)
      : decodeBase64(fromTextarea.value, decodeError)

    if (toTextarea.value.trim() === '') {
      copyButton.style.display = 'none'
    } else {
      copyButton.style.display = 'inline-flex'
    }
  }

  const debouncedTransform = debounce(transform, 150)

  swapButton.addEventListener('click', () => {
    ;[fromTextarea.value, toTextarea.value] = [toTextarea.value, fromTextarea.value]
    ;[fromLabel.textContent, toLabel.textContent] = [toLabel.textContent, fromLabel.textContent]
    ;[fromTextarea.name, toTextarea.name] = [toTextarea.name, fromTextarea.name]
  })

  fromTextarea.addEventListener('input', debouncedTransform)
  copyButton.addEventListener(
    'click',
    async () => await copyToClipboard(toTextarea.value, successCopy)
  )
</script>
